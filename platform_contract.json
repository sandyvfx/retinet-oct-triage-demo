      {
        "control": "segregated_phi_vault",
        "implementation": "PHI lookup remains in a separate encrypted service boundary"
      },
      {
        "control": "least_privilege_access",
        "implementation": "doctor, technician, ai_service, admin, and auditor roles are separated"
      },
      {
        "control": "hashing",
        "implementation": "file SHA256 and pseudonymous case_hash are generated before workflow routing"
      },
      {
        "control": "encryption",
        "implementation": "KMS-backed envelope encryption is required for PHI and raw vendor objects"
      },
      {
        "control": "audit_logs",
        "implementation": "append-only audit event stream with event_hash and previous_event_hash"
      },
      {
        "control": "break_glass_review",
        "implementation": "emergency access requires reason code and elevated audit severity"
      },
      {
        "control": "retention_delete",
        "implementation": "retention class is bound to tenant policy and legal hold state"
      }
